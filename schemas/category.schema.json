{
  "name": "category",
  "version": "1.0.0",
  "description": "Pet category from OA3 Petstore",
  "storage": "mongo",
  "collection": "categories",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": {
        "type": "string",
        "description": "Category name",
        "example": "Dogs"
      }
    }
  },
  "indexes": [
    { "fields": ["name"], "unique": true }
  ]
}
