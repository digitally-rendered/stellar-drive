{
  "name": "pet",
  "version": "1.0.0",
  "description": "Pet entity from OA3 Petstore benchmark",
  "storage": "mongo",
  "collection": "pets",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["name", "status"],
    "properties": {
      "name": {
        "type": "string",
        "description": "Name of the pet"
      },
      "status": {
        "type": "string",
        "description": "Pet status in the store",
        "enum": ["available", "pending", "sold"],
        "default": "available"
      },
      "category": {
        "type": "string",
        "description": "Category of the pet"
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Tags for the pet"
      },
      "photo_urls": {
        "type": "array",
        "items": { "type": "string" },
        "description": "URLs of photos of the pet"
      }
    }
  },
  "indexes": [
    { "fields": ["status"], "unique": false },
    { "fields": ["name"], "unique": false }
  ]
}
