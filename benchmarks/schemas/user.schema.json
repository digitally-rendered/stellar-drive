{
  "name": "user",
  "version": "1.0.0",
  "description": "User account from OA3 Petstore benchmark",
  "storage": "mongo",
  "collection": "users",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["username", "email"],
    "properties": {
      "username": {
        "type": "string",
        "description": "User login name"
      },
      "first_name": {
        "type": "string",
        "description": "First name"
      },
      "last_name": {
        "type": "string",
        "description": "Last name"
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "User email address"
      },
      "phone": {
        "type": "string",
        "description": "Phone number"
      },
      "user_status": {
        "type": "integer",
        "description": "User status (1=active, 0=inactive)",
        "default": 1
      }
    }
  },
  "indexes": [
    { "fields": ["username"], "unique": false },
    { "fields": ["email"], "unique": false }
  ]
}
