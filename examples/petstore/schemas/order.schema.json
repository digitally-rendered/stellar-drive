{
  "name": "order",
  "version": "1.0.0",
  "description": "Store order from OA3 Petstore",
  "storage": "mongo",
  "collection": "orders",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["pet_id", "quantity"],
    "properties": {
      "pet_id": {
        "type": "string",
        "description": "Reference to the pet being ordered"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "example": 7
      },
      "ship_date": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "type": "string",
        "description": "Order status",
        "enum": ["placed", "approved", "delivered"],
        "default": "placed"
      },
      "complete": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "indexes": [
    { "fields": ["status"], "unique": false },
    { "fields": ["pet_id"], "unique": false }
  ]
}
